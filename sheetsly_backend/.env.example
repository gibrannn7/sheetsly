# ============================================================
# SHEETSLY BACKEND CONFIGURATION (.env.example)
# ============================================================

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_NAME=Sheetsly
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------
# Server & Network Settings
# ------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins (comma-separated list or single URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# File Ingestion & Storage Settings
# ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
TEMP_FILE_DIRECTORY=./storage/temp

# ------------------------------------------------------------
# AI / LLM Configuration (Reserved for Phase 8)
# In Phase 1-7 BETA, the LLM integration is strictly inactive.
# ------------------------------------------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen3.5-plus
QWEN_BASE_URL=https://ws-6avfe6m7o2twqwqw9n.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=true

# ------------------------------------------------------------
# Database Settings (Reserved for future persistence)
# Disabled in MVP BETA.
# ------------------------------------------------------------
DATABASE_ENABLED=false
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/sheetsly
